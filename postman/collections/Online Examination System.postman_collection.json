				{
					"name": "Grade Descriptive Answer",
					"request": {
						"method": "PUT",
						"url": {
							"raw": "{{baseUrl}}/answers/grade?attemptId={{attemptId}}&questionId={{descQuestionId}}&score=70&gradedById={{teacherId}}",
							"host": ["{{baseUrl}}"],
							"path": ["answers", "grade"],
							"query": [
								{ "key": "attemptId", "value": "{{attemptId}}" },
								{ "key": "questionId", "value": "{{descQuestionId}}" },
								{ "key": "score", "value": "70" },
